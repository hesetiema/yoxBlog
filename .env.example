# 写作台（/admin）用到的环境变量。
# 本地开发：复制成 .env 填好即可；线上：在 Vercel 项目的 Settings → Environment Variables 里配同名变量，然后重新部署。

# 进入写作台的密码，自己定，别用弱密码
ADMIN_PASSWORD=

# GitHub 细粒度 PAT（https://github.com/settings/personal-access-tokens）：
# 只授权本博客仓库（见下面 GITHUB_OWNER / GITHUB_REPO），权限勾 Contents → Read and write
GITHUB_TOKEN=

# 仓库归属与分支（GITHUB_BRANCH 不填默认 main）
GITHUB_OWNER=hesetiema
GITHUB_REPO=yoxBlog
GITHUB_BRANCH=main

# 文章提交到仓库的哪个目录，不填默认 src/content/blog
# GITHUB_BLOG_DIR=src/content/blog

# 生成后的站点地址，用于发布成功后回显文章链接
SITE_URL=https://wuyox.vercel.app

# frontmatter 里的作者名，不填默认 Yoxwu
# BLOG_AUTHOR=Yoxwu
