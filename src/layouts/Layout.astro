---
import { existsSync, readdirSync } from 'node:fs';
import { join } from 'node:path';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	/** 手动指定高亮哪个导航项，用于文章页归属分类 */
	activeNav?: string;
	/** 文章发布/修订时间，用于 article 结构化信息 */
	publishedTime?: Date;
	modifiedTime?: Date;
}

const {
	title = 'Yoxwu 的博客',
	description = '记录技术、生活，和一些想明白的事。',
	activeNav,
	publishedTime,
	modifiedTime,
} = Astro.props;

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const canonical = new URL(path, Astro.site ?? 'https://yoxwu.com').href;

const navItems = [
	{ label: '技术', href: '/category/tech' },
	{ label: '生活', href: '/category/life' },
	{ label: '思考', href: '/category/thoughts' },
];

/*
	字体文件名带内容指纹（scripts/subset-font.mjs 生成），这里在构建时读目录拿到真实文件名。
	指纹化之后字体可以配 immutable 长缓存：字符集不变就一直命中缓存，变了就自动换 URL。
*/
// 用 cwd 而不是 import.meta.url：构建后组件被编译进 dist/.prerender/chunks，相对路径会算错
const fontDir = join(process.cwd(), 'public', 'fonts');
const fontFile = existsSync(fontDir)
	? readdirSync(fontDir).find((name) => /^lxgw-wenkai-400(\.[0-9a-z]+)?\.woff2$/.test(name))
	: undefined;

if (!fontFile) {
	throw new Error('public/fonts 下找不到字体子集，先运行 pnpm fonts 生成');
}

const fontHref = `/fonts/${fontFile}`;
const fontFaceCss = `@font-face{font-family:'LXGW WenKai';font-style:normal;font-weight:400;font-display:optional;src:url('${fontHref}') format('woff2');}`;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<script is:inline>
			(() => {
				try {
					const saved = localStorage.getItem('theme');
					const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
					document.documentElement.dataset.theme =
						saved === 'light' || saved === 'dark' ? saved : prefersDark ? 'dark' : 'light';
				} catch {
					document.documentElement.dataset.theme = 'light';
				}
			})();
		</script>
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<!--
			字体自托管：scripts/subset-font.mjs 把整站字符打成单个 woff2（单字重 400，粗体由浏览器合成）。
			这里有两个关键点，少一个就会闪：
			1. @font-face 内联在 head，字号/字族解析第一帧就带着字体规则，不用等外部 CSS；
			2. font-display: optional —— 字体没赶上首帧就整页用回退体，绝不"先画一遍再换字"。
			   用 swap 时网络一慢就是整页重排（每行断行都会变），那就是肉眼看到的闪动。
		-->
		<link rel="preload" href={fontHref} as="font" type="font/woff2" crossorigin />
		<style is:inline set:html={fontFaceCss}></style>
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" type="application/rss+xml" title="Yoxwu 的博客" href={new URL('/rss.xml', Astro.site ?? 'https://yoxwu.com')} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={publishedTime ? 'article' : 'website'} />
		<meta property="og:site_name" content="Yoxwu" />
		<meta property="og:url" content={canonical} />
		{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
		{modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main">跳到正文</a>

		<header class="site-header">
			<div class="container header-inner">
				<div class="header-left">
					<a class="brand" href="/">Yoxwu</a>
					<nav class="site-nav" aria-label="主导航">
						{navItems.map((item) => (
							<a
								href={item.href}
								class:list={['nav-link', { 'is-active': activeNav ? activeNav === item.href : path.startsWith(item.href) }]}
							>
								{item.label}
							</a>
						))}
					</nav>
				</div>

				<button class="theme-toggle" id="theme-toggle" type="button" aria-label="切换深浅色主题">
					<svg class="icon-sun" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
						<circle cx="12" cy="12" r="4" fill="currentColor"></circle>
						<g stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
							<path d="M12 2.4v2.1M12 19.5v2.1M2.4 12h2.1M19.5 12h2.1M5.2 5.2l1.5 1.5M17.3 17.3l1.5 1.5M18.8 5.2l-1.5 1.5M6.7 17.3l-1.5 1.5" />
						</g>
					</svg>
					<svg class="icon-moon" viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
						<path d="M20.5 14.8A8.7 8.7 0 0 1 9.2 3.5a8.9 8.9 0 1 0 11.3 11.3Z" fill="currentColor"></path>
					</svg>
				</button>
			</div>
		</header>

		<main id="main" class="site-main">
			<div class="container">
				<slot />
			</div>
		</main>

		<button class="to-top" id="to-top" type="button" aria-label="回到顶部">
			<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
				<path
					d="M12 19V6M6 12l6-6 6 6"
					fill="none"
					stroke="currentColor"
					stroke-width="1.8"
					stroke-linecap="round"
					stroke-linejoin="round"></path>
			</svg>
		</button>

		<script is:inline>
			(() => {
				const button = document.getElementById('theme-toggle');
				const root = document.documentElement;
				if (!button) return;

				const sync = () => {
					button.setAttribute('aria-label', root.dataset.theme === 'dark' ? '切换到浅色主题' : '切换到深色主题');
				};

				sync();
				button.addEventListener('click', () => {
					const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
					root.dataset.theme = next;
					try {
						localStorage.setItem('theme', next);
					} catch {
						/* 隐私模式下忽略 */
					}
					sync();
				});
			})();
		</script>

		<script is:inline>
			(() => {
				/* 代码块复制按钮：文案统一英文 */
				const copyLabel = (button, text) => {
					button.textContent = text;
					setTimeout(() => {
						button.textContent = 'Copy';
					}, 1600);
				};

				document.querySelectorAll('.prose pre').forEach((pre) => {
					// 包一层，按钮才不会跟着代码的横向滚动跑掉
					if (pre.parentElement?.classList.contains('code-block')) return;

					const button = document.createElement('button');
					button.type = 'button';
					button.className = 'copy-btn';
					button.textContent = 'Copy';
					button.addEventListener('click', async () => {
						const text = pre.querySelector('code')?.innerText ?? pre.innerText;
						try {
							await navigator.clipboard.writeText(text);
							copyLabel(button, 'Copied');
						} catch {
							copyLabel(button, 'Failed');
						}
					});

					const wrapper = document.createElement('div');
					wrapper.className = 'code-block';
					pre.parentNode.insertBefore(wrapper, pre);
					wrapper.appendChild(pre);
					wrapper.appendChild(button);
				});

				/* 标题锚点：hover 时出现一个 #，方便分享某一节 */
				document.querySelectorAll('.prose h2[id], .prose h3[id]').forEach((heading) => {
					if (heading.querySelector('.anchor')) return;
					const link = document.createElement('a');
					link.className = 'anchor';
					link.href = `#${heading.id}`;
					// 视觉上的 # 交给 CSS ::after，避免污染标题文本（复制标题时不会多出一个 #）
					link.setAttribute('aria-label', `链接到「${heading.textContent.trim()}」`);
					heading.appendChild(link);
				});

				/* 目录高亮：按滚动位置点亮当前章节，只变色不改字重（改字重会抖） */
				const tocLinks = Array.from(document.querySelectorAll('.toc-list a[href^="#"]'));
				if (tocLinks.length) {
					const targets = tocLinks
						.map((link) => ({
							link,
							heading: document.getElementById(decodeURIComponent(link.hash.slice(1))),
						}))
						.filter((item) => item.heading);

					// 窄屏折叠目录与桌面侧栏目录指向同一批标题，去重后按文档顺序排列
					const headings = [...new Set(targets.map((item) => item.heading))];

					// 判定线压在固定头部下沿稍下方：标题滚过头部才算「读到」
					const LINE = 100;
					let maxScroll = 0;
					let points = [];
					let current = null;
					let ticking = false;

					// 标题位置一次性量好缓存成文档坐标；滚动时只读 scrollY，不碰 DOM
					const measure = () => {
						const scrollY = window.scrollY;
						maxScroll = document.documentElement.scrollHeight - window.innerHeight;
						points = headings
							.map((heading) => ({ heading, top: heading.getBoundingClientRect().top + scrollY }))
							.sort((a, b) => a.top - b.top);
					};

					const update = () => {
						ticking = false;
						const scrollY = window.scrollY;
						const edge = scrollY + LINE;
						let active = points[0]?.heading ?? null;
						for (const point of points) {
							if (point.top <= edge) active = point.heading;
							else break;
						}
						// 已经到底：末尾几节滚不过判定线，把高亮直接落到最后一节
						if (points.length && maxScroll - scrollY <= 2) active = points[points.length - 1].heading;
						if (!active || active === current) return;
						current = active;
						for (const item of targets) item.link.classList.toggle('is-active', item.heading === active);
					};

					const onScroll = () => {
						if (ticking) return;
						ticking = true;
						requestAnimationFrame(update);
					};

					const remeasure = () => {
						measure();
						update();
					};

					window.addEventListener('scroll', onScroll, { passive: true });
					window.addEventListener('resize', remeasure);
					// 字体没赶上首帧会回退换行、图片撑高也会挪标题，定下来之后重量一次
					document.fonts?.ready.then(remeasure);
					window.addEventListener('load', remeasure);
					remeasure();
				}

				/* 正文图片放大：点一下用原生 dialog 打开，点任意处或 Esc 关闭 */
				let viewer = null;
				const openViewer = (img) => {
					if (!viewer) {
						viewer = document.createElement('dialog');
						viewer.className = 'img-viewer';
						viewer.setAttribute('aria-label', '图片预览');
						viewer.appendChild(document.createElement('img')).alt = '';
						document.body.appendChild(viewer);
						// 点图片或遮罩都关掉；Esc 是 dialog 自带的行为
						viewer.addEventListener('click', () => viewer.close());
					}
					const large = viewer.firstElementChild;
					large.src = img.currentSrc || img.src;
					large.alt = img.alt || '';
					viewer.showModal();
				};

				/* 用事件委托：正文里后插入的图片（如懒加载替换）也同样能点开 */
				document.addEventListener('click', (event) => {
					const img = event.target instanceof Element ? event.target.closest('.prose img') : null;
					// 图片套在链接里时交还给链接，别抢走跳转
					if (!img || img.closest('a')) return;
					event.preventDefault();
					openViewer(img);
				});

				/* 回到顶部：滚过一屏才淡入，点击平滑回顶（尊重系统的减少动效设置） */
				const toTop = document.getElementById('to-top');
				if (toTop) {
					let shown = false;
					const sync = () => {
						const next = window.scrollY > window.innerHeight;
						if (next === shown) return;
						shown = next;
						toTop.classList.toggle('is-visible', next);
					};

					window.addEventListener('scroll', sync, { passive: true });
					window.addEventListener('resize', sync);
					sync();

					toTop.addEventListener('click', () => {
						const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
						window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
					});
				}
			})();
		</script>
	</body>
</html>

<style>
	.skip-link {
		position: absolute;
		top: -100%;
		left: 1rem;
		z-index: 100;
		padding: 0.5rem 0.9rem;
		background: var(--ink);
		color: var(--bg);
		font-size: 0.8125rem;
	}

	.skip-link:focus-visible {
		top: 0.5rem;
	}

	/*
		fixed 而不是 sticky：sticky 每帧都要按滚动位置重新计算位置、重绘整条 header，
		快速滚动时文字会跟着抖一下；fixed 的元素交给合成器，滚动过程中完全不参与布局。
		参考站 tw93.fun 用的也是 fixed。高度固定为 --header-h，body 用同样的 padding-top 让开。
	*/
	.site-header {
		position: fixed;
		inset: 0 0 auto 0;
		height: var(--header-h);
		z-index: 50;
		background: var(--surface);
		border-bottom: 1px solid var(--line);
	}

	.header-inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
		height: 60px;
	}

	.header-left {
		display: flex;
		align-items: center;
		gap: 1.75rem;
		min-width: 0;
	}

	.brand {
		font-size: 1.25rem;
		font-weight: 700;
		letter-spacing: 0.02em;
		white-space: nowrap;
	}

	.site-nav {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}

	.nav-link {
		font-size: 0.9375rem;
		color: var(--ink-soft);
		transition: color 200ms var(--ease);
	}

	.nav-link:hover {
		color: var(--ink);
	}

	/* 当前栏目只加深颜色：不加下划线、不改字重，切换页面时导航不会左右跳 */
	.nav-link.is-active {
		color: var(--ink-strong);
	}

	.theme-toggle {
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		padding: 0;
		border: none;
		background: none;
		color: var(--ink-soft);
		cursor: pointer;
		transition: color 160ms var(--ease);
	}

	.theme-toggle:hover {
		color: var(--ink);
	}

	.theme-toggle .icon-sun,
	.theme-toggle .icon-moon {
		grid-area: 1 / 1;
	}

	.theme-toggle .icon-moon,
	:global(:root[data-theme='dark']) .theme-toggle .icon-sun {
		display: none;
	}

	:global(:root[data-theme='dark']) .theme-toggle .icon-moon {
		display: block;
	}

	.site-main {
		flex: 1 0 auto;
		width: 100%;
		padding-bottom: clamp(3rem, 8vw, 6rem);
	}

	/*
		回到顶部：滚过一屏才淡入。
		用 opacity + visibility 藏，不加 display —— display 会打断过渡，也会让 Tab 顺序跳一下；
		visibility: hidden 的元素本身就不可聚焦，键盘操作不会落到看不见的按钮上。
	*/
	.to-top {
		position: fixed;
		right: clamp(1rem, 3vw, 1.75rem);
		bottom: clamp(1rem, 3vw, 1.75rem);
		z-index: 40;
		display: grid;
		place-items: center;
		width: 38px;
		height: 38px;
		padding: 0;
		border: 1px solid var(--line);
		border-radius: 50%;
		background: var(--surface);
		color: var(--ink-soft);
		cursor: pointer;
		opacity: 0;
		visibility: hidden;
		transform: translateY(6px);
		transition:
			opacity 200ms var(--ease),
			transform 200ms var(--ease),
			visibility 200ms var(--ease),
			color 160ms var(--ease),
			border-color 160ms var(--ease);
	}

	.to-top.is-visible {
		opacity: 1;
		visibility: visible;
		transform: none;
	}

	.to-top:hover {
		color: var(--ink);
		border-color: var(--line-strong);
	}

	@media (prefers-reduced-motion: reduce) {
		.to-top {
			transition: none;
		}
	}

	@media (max-width: 560px) {
		.header-inner {
			gap: 0.75rem;
		}

		.header-left {
			gap: 1.1rem;
		}

		.site-nav {
			gap: 0.9rem;
		}

		.nav-link {
			font-size: 0.875rem;
		}
	}
</style>
