---
interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Yoxwu Blog',
	description = '关于 JavaScript、语言设计与前端实现的中文技术博客。',
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Public+Sans:wght@400;500;600;700;800&display=swap"
			rel="stylesheet"
		/>
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{title}</title>
	</head>
	<body>
		<div class="site-shell">
			<div class="ambient ambient-left"></div>
			<div class="ambient ambient-right"></div>
			<header class="site-header">
				<a class="site-brand" href="/">
					<span class="site-brand-mark">YB</span>
					<span class="site-brand-copy">
						<strong>Yoxwu Blog</strong>
						<small>中文前端与语言笔记</small>
					</span>
				</a>
				<p class="site-tagline">对 JavaScript 语言细节、设计取舍与工程实践的长期记录。</p>
			</header>
			<slot />
		</div>
	</body>
</html>

<style>
	:root {
		--bg: #f3f4f5;
		--paper: rgba(255, 255, 255, 0.92);
		--paper-strong: #ffffff;
		--paper-soft: rgba(244, 246, 248, 0.88);
		--ink: #36454f;
		--muted: #708090;
		--line: rgba(54, 69, 79, 0.12);
		--line-strong: rgba(54, 69, 79, 0.22);
		--accent: #36454f;
		--accent-soft: #708090;
		--accent-deep: #1f2a33;
		--glow: 0 0 0 1px rgba(54, 69, 79, 0.04), 0 20px 50px rgba(54, 69, 79, 0.08);
		--shadow: 0 20px 50px rgba(54, 69, 79, 0.08);
	}

	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		background:
			radial-gradient(circle at 14% 10%, rgba(112, 128, 144, 0.12), transparent 24%),
			radial-gradient(circle at 84% 12%, rgba(211, 211, 211, 0.42), transparent 20%),
			linear-gradient(180deg, #fafafa 0%, #f3f4f5 48%, #eceff1 100%);
		color: var(--ink);
		font-family: 'Public Sans', sans-serif;
	}

	body {
		position: relative;
		overflow-x: hidden;
	}

	body::before {
		content: '';
		position: fixed;
		inset: 0;
		background-image:
			linear-gradient(rgba(54, 69, 79, 0.04) 1px, transparent 1px),
			linear-gradient(90deg, rgba(54, 69, 79, 0.04) 1px, transparent 1px);
		background-size: 48px 48px;
		opacity: 0.45;
		pointer-events: none;
	}

	a {
		color: inherit;
	}

	.site-shell {
		position: relative;
		max-width: 1180px;
		margin: 0 auto;
		padding: 28px 20px 72px;
	}

	.ambient {
		position: fixed;
		z-index: 0;
		width: 30rem;
		height: 30rem;
		border-radius: 999px;
		filter: blur(110px);
		pointer-events: none;
		opacity: 0.65;
	}

	.ambient-left {
		top: -8rem;
		left: -10rem;
		background: rgba(112, 128, 144, 0.18);
	}

	.ambient-right {
		top: 6rem;
		right: -12rem;
		background: rgba(211, 211, 211, 0.5);
	}

	.site-header {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 20px;
		align-items: end;
		padding: 20px 0 30px;
		border-bottom: 1px solid var(--line);
		margin-bottom: 36px;
	}

	.site-brand {
		display: inline-flex;
		align-items: center;
		gap: 16px;
		text-decoration: none;
	}

	.site-brand-mark {
		display: inline-grid;
		place-items: center;
		width: 54px;
		height: 54px;
		border-radius: 14px;
		background: linear-gradient(135deg, #36454f 0%, #708090 100%);
		color: #ffffff;
		font-weight: 800;
		letter-spacing: 0.12em;
		box-shadow: 0 14px 28px rgba(54, 69, 79, 0.16);
	}

	.site-brand-copy {
		display: grid;
		gap: 4px;
	}

	.site-brand-copy strong {
		font-family: 'Public Sans', sans-serif;
		font-size: clamp(1.9rem, 3vw, 2.5rem);
		font-weight: 800;
		line-height: 1;
		letter-spacing: -0.05em;
	}

	.site-brand-copy small,
	.site-tagline {
		color: var(--muted);
		font-size: 0.95rem;
	}

	.site-brand-copy small {
		font-family: 'IBM Plex Mono', monospace;
		letter-spacing: 0.06em;
		text-transform: uppercase;
	}

	.site-tagline {
		max-width: 28rem;
		margin: 0;
		text-align: right;
		line-height: 1.65;
		text-wrap: balance;
	}

	@media (max-width: 860px) {
		.site-shell {
			padding-inline: 16px;
		}

		.site-header {
			grid-template-columns: 1fr;
			align-items: start;
		}

		.site-tagline {
			text-align: left;
		}
	}
</style>
