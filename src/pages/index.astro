---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((firstPost, secondPost) => {
	return secondPost.data.date.getTime() - firstPost.data.date.getTime();
});

const [featuredPost, ...otherPosts] = posts;
const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((firstTag, secondTag) =>
	firstTag.localeCompare(secondTag, 'zh-CN')
);
const totalTags = allTags.length;
const latestRefresh = posts.reduce((latestTimestamp, post) => {
	const updatedAt = post.data.updatedAt ?? post.data.date;
	return Math.max(latestTimestamp, updatedAt.getTime());
}, 0);
const spotlightPosts = posts.slice(0, 3);
---

<Layout title="Yoxwu Blog | 首页" description="中文前端与 JavaScript 语言笔记列表，包含摘要、标签与专题文章入口。">
	<main class="page">
		<section class="hero-grid">
			<div class="hero-copy frame">
				<p class="eyebrow">Tech Innovation / Frontend Chronicle</p>
				<h1>把语言细节、实现机制和工程经验整理成一份可检索的技术信号面板。</h1>
				<p class="hero-summary">
					这里不是普通文章流，而是一份持续扩展的中文前端知识入口。你可以先看摘要、标签、更新节奏，再决定要不要深入读完整文章。
				</p>
				<div class="hero-actions">
					<a class="primary-link" href={featuredPost ? `/posts/${featuredPost.id}` : '#latest'}>进入本期主文</a>
					<a class="secondary-link" href="#signal-map">查看主题地图</a>
				</div>
			</div>

			<aside class="hero-panel frame" aria-label="站点概览">
				<div class="signal-header">
					<p class="signal-kicker">Signal Board</p>
					<p class="signal-title">持续更新的 JavaScript / 规范 / 数据结构索引</p>
				</div>
				<div class="signal-metrics">
					<div>
						<strong>{posts.length}</strong>
						<span>篇已发布文章</span>
					</div>
					<div>
						<strong>{totalTags}</strong>
						<span>个主题标签</span>
					</div>
				</div>
				<div class="signal-meta">
					<p>最新更新</p>
					<strong>{latestRefresh ? new Date(latestRefresh).toLocaleDateString('zh-CN') : '暂无'}</strong>
				</div>
				<ul class="signal-list">
					{spotlightPosts.map((post) => (
						<li>
							<a href={`/posts/${post.id}`}>
								<span>{post.data.title}</span>
								<small>{post.data.tags.slice(0, 2).join(' / ')}</small>
							</a>
						</li>
					))}
				</ul>
			</aside>
		</section>

		<section class="topic-strip frame" id="signal-map" aria-label="标签导航">
			<div class="section-head">
				<p class="section-kicker">Signal Map</p>
				<h2>按主题快速切入，而不是从时间线盲翻。</h2>
			</div>
			<div class="topic-cloud">
				{allTags.map((tag, index) => (
					<a class={`topic-pill topic-pill-${(index % 4) + 1}`} href={`/tags/${encodeURIComponent(tag)}`}>{tag}</a>
				))}
			</div>
		</section>

		{featuredPost && (
			<article class="featured-post frame" id="latest">
				<div class="featured-copy">
					<p class="section-kicker">Featured Decode</p>
					<h2>{featuredPost.data.title}</h2>
					<p class="post-description featured-description">{featuredPost.data.description}</p>
					<div class="featured-meta-grid">
						<div>
							<span>作者</span>
							<strong>{featuredPost.data.author}</strong>
						</div>
						<div>
							<span>发布日期</span>
							<strong>{featuredPost.data.date.toLocaleDateString('zh-CN')}</strong>
						</div>
						<div>
							<span>专题</span>
							<strong>{featuredPost.data.series ?? '独立文章'}</strong>
						</div>
						<div>
							<span>最近修订</span>
							<strong>{(featuredPost.data.updatedAt ?? featuredPost.data.date).toLocaleDateString('zh-CN')}</strong>
						</div>
					</div>
					<ul class="tag-list" aria-label="文章标签">
						{featuredPost.data.tags.map((tag) => <li><a href={`/tags/${encodeURIComponent(tag)}`}>{tag}</a></li>)}
					</ul>
					<a class="primary-link" href={`/posts/${featuredPost.id}`}>阅读全文</a>
				</div>
				<a class="featured-cover-link" href={`/posts/${featuredPost.id}`}>
					<img class="featured-cover" src={featuredPost.data.cover} alt={featuredPost.data.title} />
				</a>
			</article>
		)}

		<section class="stream-head">
			<div>
				<p class="section-kicker">Latest Stream</p>
				<h2>最近文章</h2>
			</div>
			<p>继续沿着摘要、专题和标签快速判断内容价值。</p>
		</section>

		<section class="post-grid" aria-label="文章列表">
			{otherPosts.map((post) => {
				return (
					<article class="post-card frame">
						<a class="post-card-cover-link" href={`/posts/${post.id}`}>
							<img class="post-card-cover" src={post.data.cover} alt={post.data.title} />
						</a>
						<div class="post-card-body">
							<p class="post-date">{post.data.date.toLocaleDateString('zh-CN')}</p>
							<p class="post-meta">{post.data.author}{post.data.series ? ` / ${post.data.series}` : ''}</p>
							<h3>
								<a href={`/posts/${post.id}`}>{post.data.title}</a>
							</h3>
							<p class="post-description">{post.data.description}</p>
							<ul class="tag-list" aria-label="文章标签">
								{post.data.tags.map((tag) => <li><a href={`/tags/${encodeURIComponent(tag)}`}>{tag}</a></li>)}
							</ul>
							<a class="read-link" href={`/posts/${post.id}`}>继续阅读</a>
						</div>
					</article>
				);
			})}
		</section>
	</main>
</Layout>

<style>
	.page {
		position: relative;
		z-index: 1;
		display: grid;
		gap: 28px;
	}

	.frame {
		background: linear-gradient(180deg, rgba(255, 255, 255, 0.96) 0%, rgba(248, 249, 250, 0.92) 100%);
		backdrop-filter: blur(10px);
		border: 1px solid var(--line);
		box-shadow: var(--glow);
	}

	.hero-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.5fr) minmax(320px, 0.9fr);
		gap: 24px;
		align-items: stretch;
	}

	.eyebrow {
		margin: 0;
		font-size: 0.82rem;
		font-family: 'IBM Plex Mono', monospace;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent-soft);
	}

	.hero-copy {
		padding: 40px;
		display: grid;
		gap: 24px;
		border-radius: 32px;
		position: relative;
		overflow: hidden;
	}

	.hero-copy::after {
		content: '';
		position: absolute;
		inset: auto -6% -28% auto;
		width: 20rem;
		height: 20rem;
		background: radial-gradient(circle, rgba(211, 211, 211, 0.75) 0%, transparent 68%);
		pointer-events: none;
	}

	.hero-copy h1 {
		margin: 0;
		max-width: 12ch;
		font-family: 'Public Sans', sans-serif;
		font-size: clamp(3rem, 6.4vw, 5rem);
		line-height: 0.94;
		font-weight: 800;
		letter-spacing: -0.07em;
	}

	.hero-summary,
	.post-description {
		color: var(--muted);
		line-height: 1.75;
	}

	.hero-summary {
		margin: 0;
		max-width: 56ch;
		font-size: 1.02rem;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
	}

	.hero-panel {
		display: grid;
		gap: 20px;
		padding: 30px;
		border-radius: 32px;
	}

	.signal-header {
		display: grid;
		gap: 8px;
	}

	.signal-kicker,
	.section-kicker {
		margin: 0;
		font-family: 'IBM Plex Mono', monospace;
		font-size: 0.78rem;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--accent-soft);
	}

	.signal-title,
	.section-head h2,
	.stream-head h2,
	.featured-copy h2,
	h3 {
		margin: 0;
		font-family: 'Public Sans', sans-serif;
		font-weight: 800;
		letter-spacing: -0.05em;
	}

	.signal-title {
		font-size: 1.1rem;
		line-height: 1.55;
	}

	.signal-metrics {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 14px;
	}

	.signal-metrics div,
	.signal-meta,
	.signal-list li,
	.featured-meta-grid div {
		padding: 16px 18px;
		border: 1px solid var(--line);
		border-radius: 18px;
		background: rgba(243, 244, 245, 0.78);
	}

	.signal-metrics strong {
		display: block;
		font-family: 'Public Sans', sans-serif;
		font-size: 2.6rem;
		line-height: 1;
		color: var(--accent-deep);
	}

	.signal-metrics span,
	.signal-meta p,
	.post-date {
		color: var(--muted);
	}

	.signal-meta {
		display: grid;
		gap: 6px;
	}

	.signal-meta p {
		margin: 0;
		font-size: 0.9rem;
	}

	.signal-meta strong {
		font-size: 1.05rem;
	}

	.signal-list {
		display: grid;
		gap: 12px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.signal-list li {
		padding: 0;
		overflow: hidden;
	}

	.signal-list a {
		display: grid;
		gap: 8px;
		padding: 16px 18px;
		text-decoration: none;
	}

	.signal-list span,
	.featured-meta-grid strong {
		font-weight: 600;
	}

	.signal-list small,
	.featured-meta-grid span,
	.stream-head p {
		color: var(--muted);
	}

	.topic-strip {
		display: grid;
		gap: 22px;
		padding: 30px;
		border-radius: 32px;
	}

	.section-head {
		display: grid;
		gap: 10px;
		max-width: 48rem;
	}

	.section-head h2,
	.stream-head h2,
	.featured-copy h2 {
		font-size: clamp(2rem, 4vw, 3.3rem);
		line-height: 1;
	}

	.topic-cloud {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.topic-pill {
		padding: 11px 16px;
		border: 1px solid var(--line-strong);
		border-radius: 999px;
		background: rgba(255, 255, 255, 0.8);
		text-decoration: none;
		font-size: 0.92rem;
		font-weight: 600;
		transition: transform 140ms ease, border-color 140ms ease, box-shadow 140ms ease;
	}

	.topic-pill:hover,
	.primary-link:hover,
	.secondary-link:hover,
	.read-link:hover,
	.signal-list a:hover {
		transform: translateY(-1px);
	}

	.topic-pill-1 {
		color: #36454f;
	}

	.topic-pill-2 {
		color: #495965;
	}

	.topic-pill-3 {
		color: #1f2a33;
	}

	.topic-pill-4 {
		color: #708090;
	}

	.primary-link,
	.secondary-link,
	.read-link {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 8px;
		text-decoration: none;
		font-weight: 700;
		transition: transform 140ms ease, border-color 140ms ease, box-shadow 140ms ease;
	}

	.primary-link {
		justify-self: start;
		padding: 12px 18px;
		border-radius: 999px;
		background: #36454f;
		color: #ffffff;
		box-shadow: 0 14px 28px rgba(54, 69, 79, 0.16);
	}

	.secondary-link,
	.read-link {
		justify-self: start;
		padding: 12px 18px;
		border-radius: 999px;
		border: 1px solid var(--line-strong);
		background: rgba(255, 255, 255, 0.72);
	}

	.featured-post {
		display: grid;
		grid-template-columns: minmax(320px, 0.95fr) minmax(0, 1.15fr);
		gap: 24px;
		padding: 30px;
		border-radius: 32px;
		overflow: hidden;
	}

	.featured-copy {
		display: grid;
		gap: 18px;
		align-content: start;
	}

	.featured-cover-link,
	.post-card-cover-link {
		display: block;
		text-decoration: none;
		border-radius: 22px;
		overflow: hidden;
		border: 1px solid var(--line);
	}

	.featured-cover,
	.post-card-cover {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.featured-description {
		max-width: 58ch;
	}

	.featured-meta-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 14px;
	}

	.post-card-body {
		display: grid;
		gap: 16px;
		padding: 24px;
	}

	.post-date {
		margin: 0;
		font-size: 0.84rem;
		font-family: 'IBM Plex Mono', monospace;
	}

	.post-meta {
		margin: -8px 0 0;
		font-size: 0.84rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--accent-soft);
	}

	h3 {
		font-size: 1.7rem;
		line-height: 1.1;
	}

	h2 a,
	h3 a,
	.featured-copy a,
	.read-link {
		text-decoration: none;
	}

	.tag-list {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.tag-list li {
		padding: 0;
		border-radius: 999px;
		overflow: hidden;
	}

	.tag-list a {
		display: inline-flex;
		padding: 8px 12px;
		border-radius: 999px;
		background: rgba(211, 211, 211, 0.34);
		color: var(--accent);
		font-size: 0.84rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-decoration: none;
	}

	.stream-head {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 18px;
		align-items: end;
		padding-top: 6px;
	}

	.stream-head p {
		max-width: 28rem;
		margin: 0;
		line-height: 1.7;
	}

	.post-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 22px;
	}

	.post-card {
		border-radius: 30px;
		overflow: hidden;
	}

	.post-card-cover {
		height: 230px;
	}

	@media (max-width: 980px) {
		.hero-grid,
		.featured-post,
		.post-grid {
			grid-template-columns: 1fr;
		}

		.hero-copy h1 {
			max-width: none;
		}

		.stream-head {
			grid-template-columns: 1fr;
			align-items: start;
		}
	}

	@media (max-width: 640px) {
		.hero-copy,
		.hero-panel,
		.topic-strip,
		.featured-post,
		.post-card-body {
			padding: 22px;
		}

		.signal-metrics,
		.featured-meta-grid {
			grid-template-columns: 1fr;
		}

		h3 {
			font-size: 1.6rem;
		}
	}
</style>