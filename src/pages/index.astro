---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { sortByDate } from '../utils/post';

const posts = sortByDate(await getCollection('blog', ({ data }) => !data.draft));
---

<Layout title="Yoxwu 的博客" description="记录技术、生活，和一些想明白的事。">
	<div class="home">
		<h1 class="visually-hidden">Yoxwu 的博客</h1>

		{posts.length > 0 ? (
			<div class="post-list">
				{posts.map((post) => <PostCard post={post} />)}
			</div>
		) : (
			<p class="empty">还没有文章，先去看看书。</p>
		)}
	</div>
</Layout>

<style>
	.home {
		padding-block: 2.5rem 0;
	}

	.empty {
		margin: 0;
		color: var(--muted);
	}

	@media (max-width: 640px) {
		.home {
			padding-block: 1.75rem 0;
		}
	}
</style>
