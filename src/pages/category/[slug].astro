---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { CATEGORIES, sortByDate } from '../../utils/post';

export async function getStaticPaths() {
	const posts = sortByDate(await getCollection('blog', ({ data }) => !data.draft));

	return CATEGORIES.map((category) => ({
		params: { slug: category.slug },
		props: {
			category,
			posts: posts.filter((post) => post.data.category === category.label),
		},
	}));
}

const { category, posts } = Astro.props;
---

<Layout title={`${category.label} | Yoxwu`} description={`${category.label} | Yoxwu 的博客`}>
	<div class="page">
		<header class="page-head">
			<h1>{category.label}</h1>
		</header>

		{posts.length > 0 ? (
			<div class="post-list">
				{posts.map((post) => <PostCard post={post} />)}
			</div>
		) : (
			<p class="empty">这一类还没有文章，之后会慢慢补上。</p>
		)}
	</div>
</Layout>

<style>
	.empty {
		margin: 0;
		color: var(--muted);
	}
</style>
