---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Toc from '../../components/Toc.astro';
import { categoryByLabel, formatDate, readingTime, sortByDate } from '../../utils/post';

export async function getStaticPaths() {
	const posts = sortByDate(await getCollection('blog', ({ data }) => !data.draft));

	/** 同系列文章，按时间正序（系列内从上到下就是阅读顺序） */
	const seriesOf = (series?: string) =>
		series
			? posts
					.filter((item) => item.data.series === series)
					.sort((first, second) => first.data.date.getTime() - second.data.date.getTime())
			: [];

	return posts.map((post, index) => ({
		params: { id: post.id },
		props: {
			post,
			olderPost: posts[index + 1] ?? null,
			newerPost: posts[index - 1] ?? null,
			seriesPosts: seriesOf(post.data.series),
		},
	}));
}

const { post, olderPost, newerPost, seriesPosts } = Astro.props;
const { Content, headings } = await render(post);
const { title, description, category, date, updatedAt, series } = post.data;
const cat = categoryByLabel(category);

/** 目录只收 h2 / h3 */
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const seriesIndex = seriesPosts.findIndex((item) => item.id === post.id);
---

<Layout
	title={`${title} | Yoxwu`}
	description={description}
	activeNav={`/category/${cat.slug}`}
	publishedTime={date}
	modifiedTime={updatedAt}
>
	<div class="post-layout">
		<article class="article">
			<a class="back" href="/">← 全部文章</a>

			<header class="head">
				<h1>{title}</h1>
				<p class="meta">
					<span class="meta-date">【{formatDate(date)}】</span>
					<a href={`/category/${cat.slug}`}>{cat.label}</a>
					<span>{readingTime(post.body)} 分钟阅读</span>
					{updatedAt && <span>修订于 {formatDate(updatedAt)}</span>}
				</p>
			</header>

			{seriesPosts.length > 1 && (
				<nav class="series" aria-label="系列文章">
					<p class="series-head">
						<span class="series-name">《{series}》</span>
						<span class="series-count">
							第 {seriesIndex + 1} 篇 / 共 {seriesPosts.length} 篇
						</span>
					</p>
					<ol class="series-list">
						{seriesPosts.map((item, index) => (
							<li class:list={['series-item', { 'is-current': item.id === post.id }]}>
								<a href={`/posts/${item.id}`} aria-current={item.id === post.id ? 'true' : undefined}>
									<span class="series-index">{index + 1}.</span>
									{item.data.title}
								</a>
							</li>
						))}
					</ol>
				</nav>
			)}

			{toc.length > 1 && <Toc headings={toc} variant="inline" />}

			<div class="body prose">
				<Content />
			</div>

			<nav class="pager" aria-label="上下篇">
				{olderPost ? (
					<a class="pager-link" href={`/posts/${olderPost.id}`}>
						<span>← 上一篇</span>
						<strong>{olderPost.data.title}</strong>
					</a>
				) : (
					<span></span>
				)}
				{newerPost ? (
					<a class="pager-link pager-link--next" href={`/posts/${newerPost.id}`}>
						<span>下一篇 →</span>
						<strong>{newerPost.data.title}</strong>
					</a>
				) : (
					<span></span>
				)}
			</nav>
		</article>

		{toc.length > 1 && <Toc headings={toc} variant="side" />}
	</div>
</Layout>

<style>
	/* 正文一列，宽屏时右侧多出一列放目录 */
	.post-layout {
		display: grid;
		grid-template-columns: minmax(0, 740px);
		justify-content: center;
		gap: 3.5rem;
		padding-block: 2.5rem 0;
	}

	@media (min-width: 1100px) {
		.post-layout {
			grid-template-columns: minmax(0, 740px) 190px;
		}
	}

	/* 网格项默认 min-width: auto，长单词/代码会把整列撑破视口 */
	.post-layout > * {
		min-width: 0;
	}

	/* 注意不要再用 margin-inline: auto：网格项上的 auto 外边距会让宽度退化成 max-content，撑破窄屏 */
	.article {
		max-width: 740px;
	}

	/* 系列导航：告诉读者这是连载的第几篇 */
	.series {
		margin: 0 0 2rem;
		padding: 0.85rem 1rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		font-size: 0.875rem;
	}

	.series-head {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 0.5rem;
		color: var(--muted);
		font-size: 0.8125rem;
	}

	.series-name {
		color: var(--ink-soft);
	}

	.series-list {
		display: grid;
		gap: 0.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.series-item a {
		display: flex;
		gap: 0.4rem;
		color: var(--ink-soft);
		transition: color 200ms var(--ease);
	}

	.series-item a:hover,
	.series-item.is-current a {
		color: var(--ink-strong);
	}

	.series-index {
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
	}

	.back {
		display: inline-block;
		margin-bottom: 1.5rem;
		color: var(--ink-soft);
		font-size: 0.8125rem;
		transition: color 200ms var(--ease);
	}

	.back:hover {
		color: var(--ink-strong);
	}

	.head {
		display: grid;
		gap: 0.7rem;
		padding-bottom: 1.75rem;
		border-bottom: 1px solid var(--line);
		margin-bottom: 2rem;
	}

	.head h1 {
		margin: 0;
		font-size: clamp(1.375rem, 0.9rem + 1.4vw, 1.875rem);
		line-height: 1.35;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0;
		margin: 0;
		color: var(--muted);
		font-size: 0.8125rem;
	}

	.meta > *:not(:last-child)::after {
		content: '·';
		margin: 0 0.5rem;
		color: var(--line-strong);
	}

	/* 头部里的分类链接不加下划线：靠比周围文字深一档的颜色做可点暗示，hover 再加深 */
	.meta a {
		color: var(--ink-soft);
		transition: color 200ms var(--ease);
	}

	.meta a:hover {
		color: var(--ink-strong);
	}

	.meta-date {
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	.body {
		max-width: 100%;
	}

	.pager {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 1.5rem;
		margin-top: 3.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
	}

	.pager-link {
		display: grid;
		gap: 0.3rem;
	}

	.pager-link span {
		color: var(--muted);
		font-size: 0.75rem;
	}

	.pager-link strong {
		font-size: 0.9375rem;
		font-weight: 500;
		line-height: 1.6;
		color: var(--ink-soft);
		transition: color 160ms var(--ease);
	}

	.pager-link:hover strong {
		color: var(--ink);
	}

	.pager-link--next {
		text-align: right;
	}

	@media (max-width: 640px) {
		.post-layout {
			padding-block: 1.75rem 0;
		}

		.meta {
			gap: 0.2rem 0;
		}

		.meta > *:not(:last-child)::after {
			margin: 0 0.4rem;
		}

		.pager {
			grid-template-columns: 1fr;
			gap: 1.25rem;
		}

		.pager-link--next {
			text-align: left;
		}
	}
</style>
