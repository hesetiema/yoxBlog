---
import Layout from '../layouts/Layout.astro';
---

<Layout title="页面不存在 | Yoxwu" description="你访问的页面不存在。">
	<div class="not-found">
		<p class="code">404</p>
		<h1>这一页不存在</h1>
		<p>链接可能失效了，或者文章还在草稿里。</p>
		<a class="home-link" href="/">← 回到首页</a>
	</div>
</Layout>

<style>
	.not-found {
		display: grid;
		justify-items: start;
		gap: 0.75rem;
		padding-block: 5rem 0;
	}

	.code {
		margin: 0;
		color: var(--muted);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		letter-spacing: 0.1em;
	}

	h1 {
		margin: 0;
		font-size: 1.75rem;
		line-height: 1.45;
	}

	.not-found p:not(.code) {
		margin: 0;
		color: var(--ink-soft);
	}

	.home-link {
		margin-top: 0.75rem;
		color: var(--muted);
		font-size: 0.875rem;
		transition: color 160ms var(--ease);
	}

	.home-link:hover {
		color: var(--ink);
	}
</style>
