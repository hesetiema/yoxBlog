---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const publishedPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort((firstPost, secondPost) => {
	return secondPost.data.date.getTime() - firstPost.data.date.getTime();
});

export async function getStaticPaths() {
	const posts = await getCollection('blog', ({ data }) => !data.draft);
	const tags = [...new Set(posts.flatMap((post) => post.data.tags))];

	return tags.map((tag) => ({
		params: { tag },
		props: {
			tag,
			posts: posts
				.filter((post) => post.data.tags.includes(tag))
				.sort((firstPost, secondPost) => secondPost.data.date.getTime() - firstPost.data.date.getTime()),
		},
	}));
}

const { tag, posts } = Astro.props;
const relatedTags = [...new Set(publishedPosts.flatMap((post) => post.data.tags))].filter((entryTag) => entryTag !== tag);
---

<Layout title={`${tag} | 标签页 | Yoxwu Blog`} description={`标签 ${tag} 下的文章列表。`}>
	<main class="page">
		<section class="tag-hero">
			<div>
				<a class="back-link" href="/">返回首页</a>
				<p class="eyebrow">Tag Archive</p>
				<h1>{tag}</h1>
				<p class="summary">这里收录所有带有“{tag}”标签的文章，方便按主题阅读和回顾。</p>
			</div>
			<div class="tag-stat">
				<strong>{posts.length}</strong>
				<span>篇相关文章</span>
			</div>
		</section>

		<section class="post-list" aria-label="标签文章列表">
			{posts.map((post) => (
				<article class="post-card">
					<a class="cover-link" href={`/posts/${post.id}`}>
						<img class="cover" src={post.data.cover} alt={post.data.title} />
					</a>
					<div class="body">
						<p class="post-date">{post.data.date.toLocaleDateString('zh-CN')}</p>
						<p class="post-meta">{post.data.author}{post.data.series ? ` / ${post.data.series}` : ''}</p>
						<h2><a href={`/posts/${post.id}`}>{post.data.title}</a></h2>
						<p class="summary">{post.data.description}</p>
					</div>
				</article>
			))}
		</section>

		{relatedTags.length > 0 && (
			<section class="related-tags" aria-label="其他标签">
				<h2>继续按主题浏览</h2>
				<div class="pill-row">
					{relatedTags.map((entryTag) => (
						<a class="pill" href={`/tags/${encodeURIComponent(entryTag)}`}>{entryTag}</a>
					))}
				</div>
			</section>
		)}
	</main>
</Layout>

<style>
	.page {
		position: relative;
		z-index: 1;
		display: grid;
		gap: 24px;
	}

	.eyebrow {
		margin: 0 0 12px;
		font-size: 0.84rem;
		letter-spacing: 0.24em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.back-link,
	h2 a,
	.pill {
		text-decoration: none;
	}

	.back-link {
		display: inline-block;
		margin-bottom: 18px;
		padding-bottom: 4px;
		border-bottom: 1px solid currentColor;
		font-weight: 700;
	}

	.tag-hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 220px;
		gap: 20px;
		padding: 28px;
		background: var(--paper);
		border: 1px solid var(--line);
		border-radius: 30px;
		box-shadow: var(--shadow);
	}

	h1,
	h2 {
		margin: 0;
		font-family: 'Cormorant Garamond', serif;
		font-weight: 700;
		line-height: 0.98;
	}

	h1 {
		font-size: clamp(3rem, 6vw, 4.6rem);
	}

	h2 {
		font-size: 2.2rem;
	}

	.summary,
	.post-date {
		margin: 0;
		color: var(--muted);
		line-height: 1.8;
	}

	.tag-stat {
		display: grid;
		align-content: end;
		gap: 8px;
		padding: 20px;
		border-radius: 24px;
		background: rgba(255, 250, 242, 0.7);
		border: 1px solid var(--line);
	}

	.tag-stat strong {
		font-family: 'Cormorant Garamond', serif;
		font-size: 3rem;
		line-height: 1;
	}

	.post-list {
		display: grid;
		gap: 18px;
	}

	.post-card {
		display: grid;
		grid-template-columns: 300px minmax(0, 1fr);
		gap: 0;
		overflow: hidden;
		border-radius: 28px;
		background: var(--paper);
		border: 1px solid var(--line);
		box-shadow: var(--shadow);
	}

	.cover-link,
	.cover {
		display: block;
	}

	.cover {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.body {
		display: grid;
		gap: 12px;
		padding: 24px;
	}

	.post-meta {
		margin: -4px 0 0;
		font-size: 0.88rem;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		color: var(--accent-deep);
	}

	.related-tags {
		display: grid;
		gap: 14px;
		padding: 28px;
		border-radius: 30px;
		background: rgba(255, 250, 242, 0.72);
		border: 1px solid var(--line);
	}

	.pill-row {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.pill {
		padding: 10px 14px;
		border-radius: 999px;
		background: rgba(165, 72, 47, 0.08);
		color: var(--accent);
		font-weight: 700;
	}

	@media (max-width: 920px) {
		.tag-hero,
		.post-card {
			grid-template-columns: 1fr;
		}
	}
</style>